# ImageRouter local runtime

# Optional. Defaults to %APPDATA%/ImageRouter on Windows and ~/.imagerouter elsewhere.
# IMAGEROUTER_DATA_DIR=C:/Users/you/AppData/Roaming/ImageRouter

# Optional. Overrides the saved dashboard setting on startup.
IMAGEROUTER_PORT=20127

# Optional request body ceiling for image/reference payloads.
IMAGEROUTER_MAX_BODY_SIZE=32mb

# Required only when starting or refreshing Antigravity OAuth connections.
# These values are intentionally not bundled in the repository.
# IMAGEROUTER_ANTIGRAVITY_CLIENT_ID=
# IMAGEROUTER_ANTIGRAVITY_CLIENT_SECRET=

# Keeps framework telemetry disabled for local development.
NEXT_TELEMETRY_DISABLED=1

# Optional E2E override. Tests otherwise discover an existing local Chromium/Chrome.
# IMAGEROUTER_PLAYWRIGHT_EXECUTABLE_PATH=C:/path/to/chrome.exe

# Optional real-provider smoke tests. These tests may incur provider charges.
# IMAGEROUTER_SMOKE_XAI_API_KEY=
# IMAGEROUTER_SMOKE_XAI_MODEL=grok-imagine-image-quality
# IMAGEROUTER_SMOKE_ANTIGRAVITY_ACCESS_TOKEN=
# IMAGEROUTER_SMOKE_ANTIGRAVITY_PROJECT_ID=
# IMAGEROUTER_SMOKE_ANTIGRAVITY_MODEL=gemini-3.1-flash-image
# IMAGEROUTER_SMOKE_CODEX_ACCESS_TOKEN=
# IMAGEROUTER_SMOKE_CODEX_ACCOUNT_ID=
# IMAGEROUTER_SMOKE_CODEX_MODEL=gpt-5.5-image
